  "sql_role_permissions": "SELECT rp.id, r.code AS rol, p.code AS permiso, rp.is_active\nFROM role_permissions rp\nJOIN roles r ON r.id = rp.role_id\nJOIN permissions p ON p.id = rp.permission_id\nORDER BY r.id, p.id",
